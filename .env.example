# Slack Incoming Webhook の URL（必須）
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# 読み取り系ツールだけを許可（送信・下書き・削除系は入れない＝事故防止）
# 既定は advanced-gmail-mcp の読み取り系ツール名。別の MCP を使う場合はそのツール名に合わせる。
GMAIL_ALLOWED_TOOLS=mcp__gmail__list_emails,mcp__gmail__search_emails,mcp__gmail__read_email,mcp__gmail__get_thread,mcp__gmail__get_labels
